---
import Head from "@components/Head.astro";
import Footer from "@components/Footer.astro";

type Props = {
  title: string;
  description: string;
  lang?: string;
};

const { title, description, lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
